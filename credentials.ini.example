// remove ".example" in extension

[env]
build_flags =
    -D WIFI_SSID=\"YOUR_WIFI_SSID\"
    -D WIFI_PASSWORD=\"YOUR_WIFI_PASSWORD\"
    -D FIREBASE_AUTH_EMAIL=\"YOUR_AUTHENTICATION_EMAIL\"
    -D FIREBASE_AUTH_PASSWORD=\"YOUR_AUTHENTICATION_PASSWORD\"
    -D FIREBASE_API_KEY=\"YOUR_API_KEY\"
    -D FIREBASE_PROJECT_ID=\"YOUR_PROJECT_ID\"